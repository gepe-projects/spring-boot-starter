  "item": [
    {
      "name": "admin",
      "description": "Semua endpoint butuh akun dengan role ADMIN (atau SUPER_ADMIN). Hierarki: SUPER_ADMIN > ADMIN > OPERATION > USER — ADMIN tidak bisa mengubah ADMIN lain, dan akun SUPER_ADMIN hanya bisa diubah oleh dirinya sendiri. Login dulu → jalankan \"list users\" (userId terisi otomatis) → coba update status / assign roles / rotate key. Cara membuat akun SUPER_ADMIN: lihat backend/readme/ADMIN.md §5a.",
      "item": [
        {
          "name": "AdminUserController",
          "item": [
            {
              "name": "list users",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Response has JSON body\", function () {",
                      "    pm.expect(pm.response.text()).to.not.be.empty;",
                      "});",
                      "",
                      "if (pm.response.code === 200 && pm.response.text()) {",
                      "    const json = pm.response.json();",
                      "    if (json.data && json.data.items && json.data.items.length > 0) {",
                      "        pm.collectionVariables.set(\"userId\", json.data.items[0].userId);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
